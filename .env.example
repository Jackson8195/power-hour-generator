# Power Hour Studio Configuration
# Copy this file to backend/.env and fill in your values

# YouTube Data API v3 key (optional - enables search)
# Get one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Spotify API (optional - enables metadata enrichment)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OpenAI API (optional - enables AI playlist generation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Paths
MEDIA_DIR=./media          # Downloaded videos stored here
RENDER_DIR=./media/renders  # Rendered power hours stored here
DATABASE_URL=sqlite:///./power_hour.db

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173

# FFmpeg
FFMPEG_PATH=ffmpeg          # Change if not on PATH

# GPU encoding (NVIDIA only). Leave off for CPU/libx264 (default; required on Mac).
# When enabled, renders use h264_nvenc IF a working NVENC encoder is detected at
# runtime, otherwise they automatically fall back to libx264. To actually use the GPU
# in Docker, also start with the GPU override:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
USE_NVENC=0
NVENC_PRESET=p5             # p1 (fastest) .. p7 (slowest); p5 ≈ x264 "medium"

# Download settings
MAX_CONCURRENT_DOWNLOADS=3
DEFAULT_VIDEO_QUALITY=720   # 360, 480, 720, 1080
